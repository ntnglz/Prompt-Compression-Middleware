# PCM MCP Server - .gitignore
# ============================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Testing
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Ollama
.ollama/

# MCP
.mcp/

# Datos de prueba (opcional: comenta si quieres versionar)
# data/
# tests/data/
# Resultados de benchmark (organizados por modelo)
data/benchmarks/runs/
# Archivos legacy planos (pre-reorganización)
data/benchmarks/benchmark_*.json
data/benchmarks/benchmark_*.md
# Resultados E2E (API Mistral)
data/e2e/runs/
# Fine-tuning checkpoints (pesos locales grandes)
data/training/checkpoints/
data/training/*.jsonl
!data/training/.gitkeep
data/training/v2/*.jsonl
!data/training/v2/.gitkeep
data/training/v2/checkpoints/
# Resultados E2E Fase 3b (gitignored — usar fase3b_validation.md)
data/e2e/fase3b_*/
# Runs holdout duplicados (conservar solo informe + results JSON)
data/benchmarks/fase3b_*_holdout_*/

# Artefactos locales RunPod / export (no versionar)
workspace/
workspace.zip
