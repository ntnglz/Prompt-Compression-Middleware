# PCM MCP Server - Configuración de Entorno
# ============================================
# Copia este archivo a .env y edita los valores según tu entorno

# Modelo por defecto de Ollama
OLLAMA_MODEL=granite4.1:3b
# Modelo fine-tuned Fase 3b (tras export_granite_ollama.sh + E2E OK)
# OLLAMA_MODEL=pcm-granite
# Modelo fine-tuned Fase 3a Mac MLX (tras export_ollama.sh)
# OLLAMA_MODEL=pcm-compressor
# En Docker Compose usar: http://ollama:11434
OLLAMA_HOST=http://localhost:11434

# API keys por proveedor upstream
# Mistral: https://console.mistral.ai/
MISTRAL_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenRouter (opcional): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Configuración del servidor HTTP (API REST)
HTTP_PORT=8080
HTTP_HOST=0.0.0.0

# Configuración del servidor MCP (streamable-http)
MCP_HTTP_PORT=8001
MCP_HTTP_HOST=0.0.0.0

# Proxy PCM → LLM upstream (OpenAI-compatible)
PCM_PROXY_PORT=8090
# Proveedor por defecto: mistral | openai | openrouter | custom
PCM_UPSTREAM_PROVIDER=mistral
# Solo para provider=custom (o override manual)
PCM_UPSTREAM_URL=https://api.mistral.ai/v1
PCM_UPSTREAM_API_KEY=
PCM_UPSTREAM_MODEL=
PCM_REASONING_EFFORT=none
PCM_COMPRESS_ROLES=user
PCM_INJECT_SYSTEM=true
PCM_PROXY_TIMEOUT=120
PCM_MIN_INSTRUCTION_TOKENS=12

# Configuración del compresor
COMPRESSOR_TEMPERATURE=0.1
COMPRESSOR_TIMEOUT=120
COMPRESSOR_MAX_TOKENS=512

# Logging
LOG_LEVEL=INFO

# Para desarrollo: ruta al modelo Ollama local
# OLLAMA_MODEL_PATH=/path/to/models
